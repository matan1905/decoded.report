# Price data keys (optional; app runs in degraded mode without them).
# TwelveData free tier ~800 credits/day: https://twelvedata.com/pricing
TWELVEDATA_API_KEY=
# Finnhub free tier (fallback): https://finnhub.io/register
FINNHUB_API_KEY=
# Market data (price/splits/float/short interest), free: 5 calls/min
MASSIVE_API_KEY=

# Ads (optional). Default network is Google AdSense: set the client ID and a
# slot ID per placement. Any other network can override a placement with raw
# markup in AD_HTML_<PLACEMENT>. Slots render empty while these are unset.
# /ads.txt is generated from ADSENSE_CLIENT.
ADSENSE_CLIENT=
AD_SLOT_TOP=
AD_SLOT_MID=
AD_SLOT_FOOTER=
AD_SLOT_SIDEBAR=
AD_SLOT_ANCHOR=
# AD_HTML_TOP=
# AD_HTML_MID=
# AD_HTML_FOOTER=
# AD_HTML_SIDEBAR=
# AD_HTML_ANCHOR=

# App metadata
SEC_USER_AGENT="decoded.report research contact@decoded.report"
APP_NAME="decoded.report"
APP_VERSION="0.1.0"
# Public origin used in bot messages and generated links (defaults to
# https://decoded.report when unset; request-context links use the
# incoming request origin instead)
BASE_URL=

# Owner console. Required for /admin/subs and /admin/leads.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
